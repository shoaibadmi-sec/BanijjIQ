{
  "name": "shererp",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "backend:dev": "tsx watch server/index.ts",
    "backend:build": "tsc -p tsconfig.server.json",
    "backend:start": "node dist-server/index.js",
    "backend:migrate": "tsx server/db/migrate-cli.ts",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:deploy": "npm run build && wrangler deploy",
    "cloudflare:migrate:local": "wrangler d1 migrations apply DB --local",
    "cloudflare:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cloudflare:backup": "wrangler d1 export DB --remote --output=./backup.sql",
    "test:mohim-parity": "tsx --test tests/mohim-*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@vitejs/plugin-vue": "5.2.1",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.3",
    "vite": "6.0.7",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vue-tsc": "2.2.0",
    "wrangler": "^4.126.0",
    "xlsx": "0.18.5"
  },
  "overrides": {
    "typescript": "5.7.3",
    "vite": "6.0.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
