{
  "name": "shererp",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "backend:dev": "tsx watch server/index.ts",
    "backend:build": "tsc -p tsconfig.server.json",
    "test:security": "node --test .agents/skills/security-audit/validate-coverage-ledger.test.cjs .agents/skills/security-audit/validate-findings.test.cjs && node --import tsx --test tests/security-*.integration.test.ts",
    "test:phase7e2:business": "node --import tsx --test tests/phase7e2-bundle-posting.business.test.ts",
    "test:phase7e2:transaction": "node --import tsx --test tests/phase7e2-bundle-posting.transaction.test.ts",
    "test:phase7e3a:business": "node --import tsx --test tests/phase7e3a-bundle-full-return.business.test.ts",
    "test:phase7e3a:transaction": "node --import tsx --test tests/phase7e3a-bundle-full-return.transaction.test.ts",
    "test:phase7e3a": "npm run test:phase7e3a:business && npm run test:phase7e3a:transaction",
    "test:phase7e2": "npm run test:phase7e2:business && npm run test:phase7e2:transaction",
    "test:phase4": "node --import tsx --test tests/phase4-*.integration.test.ts react-integration/tests/phase4-purchase-functions.test.ts",
    "test:phase4:coverage": "node --import tsx --experimental-test-coverage --test-coverage-include='server/modules/purchases/**' --test tests/phase4-*.integration.test.ts",
    "backend:start": "node dist-server/index.js",
    "backend:migrate": "tsx server/db/migrate-cli.ts",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:deploy": "npm run build && wrangler deploy",
    "cloudflare:migrate:local": "wrangler d1 migrations apply DB --local",
    "cloudflare:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cloudflare:backup": "wrangler d1 export DB --remote --output=./backup.sql",
    "react:prepare": "git submodule update --init --recursive apps/hisabiq-web && node scripts/prepare-hisabiq-react.mjs",
    "react:build": "npm run react:prepare && npm ci --prefix .generated/hisabiq-web && npm run build --prefix .generated/hisabiq-web",
    "react:dev": "npm run react:prepare && npm run dev --prefix .generated/hisabiq-web",
    "preview:pr-build": "node scripts/preview/pr-preview-build.mjs",
    "preview:pr-deploy": "wrangler preview --config wrangler.hisabiq-pr.generated.jsonc",
    "preview:pr-no-production": "node scripts/preview/no-production-deploy.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@vitejs/plugin-vue": "5.2.1",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.3",
    "vite": "6.0.7",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vue-tsc": "2.2.0",
    "wrangler": "^4.126.0",
    "xlsx": "0.18.5"
  },
  "overrides": {
    "typescript": "5.7.3",
    "vite": "6.0.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
