{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shererp-new",
  "main": "server/runtime/cloudflare.ts",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shererp-new-db",
      "database_id": "a94f21eb-bbd1-4ee8-8817-60726b547615",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "shererp-bundle-preview-db",
        "database_id": "18154f25-adde-42e0-b7c0-bd5501535061"
      }
    ]
  }
}
